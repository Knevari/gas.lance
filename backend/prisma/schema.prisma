generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING // Order received, waiting for gas condition
  BROADCASTED // Transaction sent to mempool, awaiting confirmation
  EXECUTED // Transaction confirmed on-chain
  FAILED // Broadcasting or execution failed
  CANCELLED // User cancelled (nonce used elsewhere)
}

model User {
  id        String   @id // Wallet address (lowercase)
  credits   Int      @default(1) // Free trial: 3 credits
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders SniperRequest[]
}

model SniperRequest {
  id         String      @id @default(uuid())
  userId     String // Wallet address of the user
  chainId    Int // e.g., 1 for Mainnet, 11155111 for Sepolia
  rawTx      String // The signed raw transaction hex
  targetGwei Float // Target base fee in Gwei
  nonce      Int // The nonce used in the signed tx
  status     OrderStatus @default(PENDING)
  txHash     String? // Transaction hash after broadcast
  error      String? // Error message if status is FAILED
  feeCredits Int         @default(1) // Credits charged for this deployment
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}
